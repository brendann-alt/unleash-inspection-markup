# Unleash live personal access token (Account > Developer > Personal access tokens)
UL_PAT=

# Media Drive GraphQL host and library CDN (defaults shown)
UL_MEDIADRIVE_URL=https://mediadrive-api.unleashlive.com
UL_LIBRARY_CDN=https://library.unleashlive.com

# Upload: S3 upload bucket + credentials issued by Unleash live
UL_UPLOAD_BUCKET=
UL_UPLOAD_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Annotation write-back. Keep "file" until the Media Drive mutation is confirmed.
UL_ADDON_ID=inspection-markup
UL_ANNOTATION_MODE=file
# GraphQL mutation taking $id: String!, $addonId: String!, $annotations: AWSJSON!
UL_ANNOTATION_MUTATION=
